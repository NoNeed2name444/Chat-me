<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The starting window and its bars stand on the page colour, so nothing changes when the
         app draws its first frame; from then on enableEdgeToEdge makes the bars clear. -->
    <style name="Base.AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/page</item>
        <item name="android:statusBarColor">@color/page</item>
        <item name="android:navigationBarColor">@color/page</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="AppTheme" parent="Base.AppTheme" />
</resources>
