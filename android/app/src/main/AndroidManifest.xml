<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- S08: a connected AI account answers over HTTPS, straight from the phone; nothing else uses the network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The 3D maps draw in OpenGL ES 3.0 (ui/map), and without it the map says so (Map3DView);
         the rest of the app needs no GL. So no glEsVersion here: Google Play filters on it even
         with required="false" (aapt2's badging lists it as uses-gl-es, never as not required),
         and it would hide the app from phones without 3.0 -->
    <application android:theme="@style/AppTheme" android:label="@string/app_name" android:icon="${appIcon}" android:allowBackup="false" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
            <!-- Sorta's own links, sorta://..., as on iOS (CFBundleURLTypes) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sorta" />
            </intent-filter>
            <!-- S06b: text shared to Sorta from another app (plugins plan idea 10): the share sheet keeps the words chosen as a new idea in To sort -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- S08 (O1): ML Kit does not start with the app. Its startup provider is taken out, and AIMlKitOnDevice
             starts ML Kit by hand the first time the phone's own model is used -->
        <provider xmlns:tools="http://schemas.android.com/tools" android:name="com.google.mlkit.common.internal.MlKitInitProvider"
            android:authorities="${applicationId}.mlkitinitprovider" tools:node="remove" />
    </application>
</manifest>
